# On Streamlit Community Cloud: Settings -> Secrets, paste contents like this.
# Locally, you can copy this to .streamlit/secrets.toml (gitignored) instead
# of typing credentials into the sidebar each time.

APP_PASSWORD = "choose-a-password-so-random-visitors-cant-use-your-credentials"

GROQ_API_KEY = "gsk_xxxxxxxxxxxxxxxx"
GROQ_MODEL = "llama-3.1-8b-instant"

GMAIL_ADDRESS = "you@gmail.com"
GMAIL_APP_PASSWORD = "xxxxxxxxxxxxxxxx"
SENDER_NAME = "Your Full Name"

TARGET_ROLE = "Software Engineer"
TARGET_COMPANY = ""

# --- Optional: powers the "Find open roles" search (free, official public API) ---
ADZUNA_APP_ID = ""
ADZUNA_APP_KEY = ""
