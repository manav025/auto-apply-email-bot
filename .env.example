# Copy this file to .env and fill in your real values. Never commit .env.

# --- Gmail sending account (for job_email_sender.py) ---
# You cannot use your normal Gmail password here. You need an "App Password":
# 1. Turn on 2-Step Verification: https://myaccount.google.com/security
# 2. Create an app password: https://myaccount.google.com/apppasswords
# 3. Paste the 16-character password below (no spaces)
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# --- Groq API key (free tier, used for both scripts) ---
# Get one at https://console.groq.com/keys -- no credit card required.
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxx
# Model used for generation. llama-3.3-70b-versatile is a good free default;
# see https://console.groq.com/docs/models for other free options.
GROQ_MODEL=llama-3.3-70b-versatile

# --- Your details, used in the generated emails ---
SENDER_NAME=Your Full Name
TARGET_ROLE=Software Engineer
TARGET_COMPANY=Acme Corp

# --- Safety throttle: seconds to wait between sends ---
SECONDS_BETWEEN_EMAILS=45
