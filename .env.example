# Copy this file to .env and fill in your real values. Never commit .env.

# --- Gmail sending account (for job_email_sender.py) ---
# You cannot use your normal Gmail password here. You need an "App Password":
# 1. Turn on 2-Step Verification: https://myaccount.google.com/security
# 2. Create an app password: https://myaccount.google.com/apppasswords
# 3. Paste the 16-character password below (no spaces)
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# --- AgentRouter API (used for both scripts) ---
AGENTROUTER_API_KEY=sk-xxxxxxxxxxxxxxxx
AGENTROUTER_BASE_URL=https://agentrouter.org/v1
AGENTROUTER_MODEL=claude-opus-4-8

# --- Your details, used in the generated emails ---
SENDER_NAME=Your Full Name
TARGET_ROLE=Software Engineer
TARGET_COMPANY=Acme Corp

# --- Safety throttle: seconds to wait between sends ---
SECONDS_BETWEEN_EMAILS=45
